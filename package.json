{
  "name": "obsidian-latex",
  "version": "0.4.1",
  "description": "Adds support for a MathJax preamble in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "author": "Xavier Denis & Ng Wei En",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.2",
    "obsidian": "^1.14.4",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  },
  "lint-staged": {
    "!(*.js)": "prettier --write --ignore-unknown",
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
